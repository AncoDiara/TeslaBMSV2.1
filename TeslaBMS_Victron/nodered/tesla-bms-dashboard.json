  {
    "id": "d0d097b22462fba3",
    "type": "exec",
    "z": "5fce40a6fa720026",
    "name": "check versions",
    "command": "mkdir -p /data/teslabms && cd /data/teslabms && python3 -c \"\nimport urllib.request, os\nfor f in ('teensy_flash.py', 'flow_update.py'):\n    u = 'https://github.com/AncoDiara/TeslaBMSV2.1/releases/latest/download/' + f\n    try:\n        d = urllib.request.urlopen(urllib.request.Request(u, headers={'User-Agent': 'teslabms'}), timeout=30).read()\n        open(f + '.tmp', 'wb').write(d); os.replace(f + '.tmp', f)\n    except Exception as e:\n        print('DL-ERROR', f, e)\n\"; echo \"FW=$(python3 teensy_flash.py --check --no-serial 2>/dev/null)\"; echo \"FLOW=$(python3 flow_update.py --check 2>/dev/null)\"",
    "addpay": "",
    "append": "",
    "useSpawn": "false",
    "timer": "120",
    "winHide": false,
    "oldrc": false,
