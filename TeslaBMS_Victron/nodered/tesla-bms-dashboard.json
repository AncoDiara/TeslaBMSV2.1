  {
    "id": "eebb922fcca50a40",
    "type": "comment",
    "z": "5fce40a6fa720026",
    "name": "Firmware & dashboard updates (scripts in /data/teslabms, fetched from the latest GitHub release)",
    "info": "",
    "x": 330,
    "y": 340,
    "wires": []
  },
  {
    "id": "497e76375b60510b",
    "type": "ui-template",
    "z": "5fce40a6fa720026",
    "group": "93f98973d193cbc6",
    "page": "",
    "ui": "",
    "name": "Updates",
    "order": 1,
    "width": "12",
    "height": "0",
    "head": "",
    "format": "<template>\n  <div class=\"upd\">\n    <div class=\"hd\" @click=\"open = !open\">\n      <span class=\"arrow\">{{ open ? '\\u25BE' : '\\u25B8' }}</span>\n      <span class=\"title\">Maintenance &amp; updates</span>\n      <span v-if=\"fwNew || flowNew\" class=\"badge\">update available</span>\n      <span v-if=\"state && !open\" class=\"mini\">{{ state }}</span>\n    </div>\n    <div v-if=\"open\">\n    <div class=\"rows\">\n      <div class=\"row\">\n        <span class=\"k\">Teensy firmware</span>\n        <span class=\"v\">{{ info.running || '-' }}</span>\n        <span class=\"k2\">latest</span>\n        <span class=\"v\">{{ info.latestFw || '-' }}</span>\n        <span v-if=\"fwNew\" class=\"badge\">update available</span>\n        <span v-else-if=\"info.latestFw && info.running\" class=\"ok\">up to date</span>\n      </div>\n      <div class=\"row\">\n        <span class=\"k\">Dashboard (flow)</span>\n        <span class=\"v\">{{ info.flowInstalled || '-' }}</span>\n        <span class=\"k2\">latest</span>\n        <span class=\"v\">{{ info.latestFlow || '-' }}</span>\n        <span v-if=\"flowNew\" class=\"badge\">update available</span>\n        <span v-else-if=\"info.latestFlow && info.flowInstalled\" class=\"ok\">up to date</span>\n      </div>\n    </div>\n    <div class=\"btns\">\n      <button @click=\"go('check')\">Check</button>\n      <button @click=\"go('fw')\" :class=\"{ hot: fwNew }\">Update Teensy firmware</button>\n      <button @click=\"go('flow')\" :class=\"{ hot: flowNew }\">Update dashboard</button>\n    </div>\n    <div v-if=\"state\" class=\"state\">{{ state }}</div>\n    <div v-if=\"info.error\" class=\"err\">{{ info.error }}</div>\n    <pre v-if=\"logText\" class=\"log\">{{ logText }}</pre>\n    <div class=\"hint\">Updates require a double click (confirmation within 10 s). During a firmware update the BMS is off for a few seconds; Victron stops charging/discharging and continues afterwards. The JSON output of the Teensy is switched on automatically by this flow.</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return { info: {}, state: '', logText: '', open: false }\n  },\n  computed: {\n    fwNew() { return !!(this.info.latestFw && this.info.running && this.info.latestFw !== this.info.running) },\n    flowNew() { return !!(this.info.latestFlow && this.info.flowInstalled && this.info.latestFlow !== this.info.flowInstalled) }\n  },\n  watch: {\n    msg: {\n      handler(m) {\n        if (!m || !m.payload) return\n        const p = m.payload\n        if (p.kind === 'info') this.info = Object.assign({}, this.info, p.info || {})\n        if (p.kind === 'state') this.state = p.text\n        if (p.kind === 'log') { this.logText = p.text; if (p.state) this.state = p.state }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    go(t) { this.send({ topic: t, payload: Date.now() }) }\n  }\n}\n</script>\n\n<style scoped>\n.upd { width: 100%; }\n.hd { display: flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; padding: 2px 0 6px; }\n.arrow { width: 14px; opacity: 0.7; }\n.title { font-weight: 600; }\n.mini { font-size: 0.85em; opacity: 0.7; }\n.rows { display: grid; gap: 6px; margin-bottom: 10px; }\n.row { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }\n.k { min-width: 140px; opacity: 0.7; }\n.k2 { opacity: 0.6; font-size: 0.85em; }\n.v { font-weight: 600; font-variant-numeric: tabular-nums; }\n.badge { padding: 2px 8px; border-radius: 10px; background: rgba(210, 153, 34, 0.22); color: #b7791f; font-weight: 600; font-size: 0.85em; }\n.ok { color: #2ea043; font-size: 0.85em; font-weight: 600; }\n.btns { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }\n.btns button { padding: 7px 14px; border-radius: 6px; border: 1px solid rgba(127, 127, 127, 0.4); background: rgba(127, 127, 127, 0.08); cursor: pointer; font: inherit; color: inherit; }\n.btns button:hover { background: rgba(127, 127, 127, 0.18); }\n.btns button.hot { border-color: #b7791f; background: rgba(210, 153, 34, 0.18); }\n.state { font-weight: 600; margin: 6px 0; }\n.err { color: #da3633; margin: 6px 0; }\n.log { max-height: 220px; overflow: auto; font-size: 0.8em; background: rgba(127, 127, 127, 0.08); padding: 8px; border-radius: 6px; white-space: pre-wrap; }\n.hint { font-size: 0.8em; opacity: 0.65; margin-top: 6px; }\n</style>\n",
