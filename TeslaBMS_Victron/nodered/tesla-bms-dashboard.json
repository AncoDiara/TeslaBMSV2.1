  {
    "id": "1854d61090a0399e",
    "type": "function",
    "z": "5fce40a6fa720026",
    "name": "Process check",
    "func": "// Output of \"check versions\": lines FW=<json> and FLOW=<json>.\nconst out = String(msg.payload || '');\nconst grab = (k) => {\n    const m = out.match(new RegExp('^' + k + '=(.*)$', 'm'));\n    if (!m) return null;\n    try { return JSON.parse(m[1]); } catch (e) { return null; }\n};\nconst fw = grab('FW') || {};\nconst fl = grab('FLOW') || {};\nconst info = {\n    running: flow.get('teensyFw') || fw.running || null,     // from the JSON output of the Teensy\n    latestFw: fw.latest || null,\n    flowInstalled: env.get('TESLABMS_FLOW_VERSION') || fl.installed || null,\n    latestFlow: fl.latest || null,\n    error: fw.error || fl.error || (out.includes('DL-ERROR') ? 'Download of the update scripts failed (internet?)' : null)\n};\nnode.status({ fill: info.error ? 'red' : 'green', shape: 'dot', text: 'fw ' + info.running + ' / ' + info.latestFw + ', flow ' + info.flowInstalled + ' / ' + info.latestFlow });\nreturn { payload: { kind: 'info', info: info } };\n",
