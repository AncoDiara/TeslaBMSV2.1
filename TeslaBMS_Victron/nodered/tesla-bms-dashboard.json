    "id": "0cf6681a8dec5e76",
    "type": "function",
    "z": "5fce40a6fa720026",
    "name": "JSON watchdog",
    "func": "// No JSON from the Teensy for 20 s? Send 'J' (JSON output on + save in the Teensy).\n// At most once per 30 s. Also covers: new Teensy, EEPROM reset, firmware update.\nconst now = Date.now();\nconst last = flow.get('teensyLastData') || 0;\nconst sent = context.get('sent') || 0;\nif (now - last > 20000) {\n    if (now - sent > 30000) {\n        context.set('sent', now);\n        node.status({ fill: 'yellow', shape: 'ring', text: 'no JSON - sent J' });\n        return { payload: 'J\\n' };\n    }\n    return null;\n}\nnode.status({ fill: 'green', shape: 'dot', text: 'JSON is arriving' });\nreturn null;\n",
