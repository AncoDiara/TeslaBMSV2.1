  {
    "id": "d267a1a09c3963a8",
    "type": "function",
    "z": "5fce40a6fa720026",
    "name": "Set port",
    "func": "// Processes the output of the \"find Teensy\" script.\nconst out = String(msg.payload || '');\nconst get = (k) => { const m = out.match(new RegExp('^' + k + '=(.*)$', 'm')); return m ? m[1].trim() : ''; };\nconst port = get('PORT'), udev = get('UDEV'), rc = get('RCLOCAL');\nconst perm = (udev === 'noperm' || rc === 'noperm') ? '  (no rights: run install-teensy-ignore.sh once via SSH)' : '';\nif (!port) {\n    node.status({ fill: 'red', shape: 'ring', text: 'Teensy not found' + perm });\n    return null;\n}\nconst current = flow.get('teensyPort');\nconst last = flow.get('teensyLastData') || 0;\nconst silent = (Date.now() - last) > 60000;   // no data for 60 s -> reconnect\nnode.status({ fill: perm ? 'yellow' : 'green', shape: 'dot', text: port.replace('/dev/serial/by-id/', '') + '  udev:' + udev + '  rc.local:' + rc + perm });\nif (port !== current || silent) {\n    flow.set('teensyPort', port);\n    return { payload: { serialport: port, serialbaud: 115200 } };\n}\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
