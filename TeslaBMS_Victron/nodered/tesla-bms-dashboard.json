  {
    "id": "dcd280ed9528145a",
    "type": "exec",
    "z": "5fce40a6fa720026",
    "name": "find Teensy + ignore rule",
    "command": "P=$(ls /dev/serial/by-id/ 2>/dev/null | grep -i -m1 teensy); if [ -n \"$P\" ]; then echo \"PORT=/dev/serial/by-id/$P\"; else echo \"PORT=\"; fi\nR=/etc/udev/rules.d/zz-teslabms-teensy.rules\nL='ACTION==\"add\", SUBSYSTEM==\"tty\", ATTRS{idVendor}==\"16c0\", ATTRS{idProduct}==\"0483\", ENV{VE_SERVICE}=\"ignore\"'\nRW=/opt/victronenergy/swupdate-scripts/remount-rw.sh\nif [ -f \"$R\" ]; then echo \"UDEV=ok\"; else [ -x \"$RW\" ] && \"$RW\" >/dev/null 2>&1; if echo \"$L\" > \"$R\" 2>/dev/null; then udevadm control --reload-rules; udevadm trigger --action=add --subsystem-match=tty; echo \"UDEV=added\"; else echo \"UDEV=noperm\"; fi; fi\nif grep -q teslabms-teensy /data/rc.local 2>/dev/null; then echo \"RCLOCAL=ok\"; elif [ -w /data ]; then [ -f /data/rc.local ] || printf '#!/bin/sh\\n' > /data/rc.local; printf '%s\\n' \"# teslabms-teensy: VE_SERVICE=ignore for the Teensy (comes back after a firmware update)\" \"[ -f $R ] || { [ -x $RW ] && $RW; echo '$L' > $R; udevadm control --reload-rules; udevadm trigger --action=add --subsystem-match=tty; }\" >> /data/rc.local; chmod +x /data/rc.local; echo \"RCLOCAL=added\"; else echo \"RCLOCAL=noperm\"; fi",
