  {
    "id": "0419efdadb7ad93b",
    "type": "function",
    "z": "5fce40a6fa720026",
    "name": "Router (check / double click)",
    "func": "// Buttons from the \"Updates\" template and the periodic check.\n// Updates need a double click: the second click must come within 10 s.\nconst now = Date.now();\nconst t = msg.topic;\nconst ui = (text) => ({ payload: { kind: 'state', text: text } });\nif (t === 'check') {\n    return [{ payload: '' }, null, null, ui('Checking versions...')];\n}\nif (t === 'fw' || t === 'flow') {\n    if (flow.get('teslabmsBusy')) return [null, null, null, ui('An update is already running - please wait')];\n    const armed = context.get('armed') || {};\n    if (armed.t === t && (now - armed.at) < 10000) {\n        context.set('armed', {});\n        flow.set('teslabmsBusy', true);\n        if (t === 'fw') {\n            node.status({ fill: 'yellow', shape: 'dot', text: 'flashing Teensy...' });\n            return [null, { payload: '' }, null, ui('Teensy firmware update running (BMS off for a few seconds)...')];\n        }\n        node.status({ fill: 'yellow', shape: 'dot', text: 'updating dashboard...' });\n        return [null, null, { payload: '' }, ui('Dashboard update running - Node-RED restarts; reload this page after about 30 s.')];\n    }\n    context.set('armed', { t: t, at: now });\n    const name = t === 'fw' ? 'Update Teensy firmware' : 'Update dashboard';\n    return [null, null, null, ui('Click \"' + name + '\" again within 10 seconds to confirm.')];\n}\nreturn null;\n",
